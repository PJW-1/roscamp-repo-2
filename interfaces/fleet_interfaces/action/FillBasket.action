# 이 로봇 트레이의 바구니에 물건을 담는다. 재시도 때 `items`에는 아직 못 담은 것만 넣는다.
# arm1과 arm2의 바구니 공간 분담은 서버가 정한다.
string order_id
string robot_id
string station_id
OrderItem[] items
---
string REASON_CANCELED="CANCELED"

# success=true: 서버가 시도를 마쳤다는 뜻이며 `missing`이 남아 있어도 true다.
# success=false: 팔이 실패했다. `placed`는 지금까지 바구니에 실제로 담긴 것이다.
bool success
OrderItem[] placed
OrderItem[] missing
string reason
---
string arm_id
string phase
int32 placed_total
