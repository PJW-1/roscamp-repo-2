Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.55
    Tree Height: 600
  - Class: rviz_common/Tool Properties
    Expanded: ~
    Name: Tool Properties
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 12
      Offset: {X: 1.85, Y: 1.3, Z: 0}
      Color: 160; 160; 164
      Alpha: 0.3
      Reference Frame: map
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.8
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: <robot_namespace>/map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: false
      Alpha: 0.3
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: <robot_namespace>/global_costmap/costmap
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Alpha: 0.6
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: <robot_namespace>/local_costmap/costmap
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: <robot_namespace>/robot_description
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      TF Prefix: ""
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.3
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Size (m): 0.02
      Style: Points
      Size (Pixels): 3
      Topic:
        Value: <robot_namespace>/scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL Particles
      Enabled: true
      Color: 0; 180; 0
      Alpha: 1
      Shape: Arrow (Flat)
      Arrow Length: 0.03
      Min Arrow Length: 0.02
      Max Arrow Length: 0.05
      Topic:
        Value: <robot_namespace>/particle_cloud
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Path
      Name: FollowPath plan (controller)
      Enabled: true
      Color: 0; 120; 255
      Line Style: Billboards
      Line Width: 0.015
      Alpha: 1
      Topic:
        Value: <robot_namespace>/received_global_plan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Planner plan (navigate_to_pose)
      Enabled: true
      Color: 255; 170; 0
      Line Style: Lines
      Alpha: 1
      Topic:
        Value: <robot_namespace>/plan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Color: 0; 200; 255
      Alpha: 1
      Topic:
        Value: <robot_namespace>/local_costmap/published_footprint
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.0025
      Covariance y: 0.0025
      Covariance yaw: 0.0076
      Topic:
        Value: <robot_namespace>/initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: <robot_namespace>/goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 220
      X: 1.85
      Y: 1.3
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
  Hide Left Dock: false
  Hide Right Dock: true
  Tool Properties:
    collapsed: true
